# Never commit real values. Generate WEB_SESSION_SECRET with at least 32 random characters.
AUTOSERVICE_DEMO_MODE=false
AUTOSERVICE_API_URL=http://127.0.0.1:8080
AUTOSERVICE_WORKSHOP_ID=11111111-1111-4111-8111-111111111111
AUTOSERVICE_USER_ID=22222222-2222-4222-8222-222222222222
WEB_SESSION_SECRET=replace-with-a-long-random-secret
WEB_ADMIN_LOGIN=admin
# Generate with: npm run auth:hash -- "your-strong-password"
WEB_ADMIN_PASSWORD_HASH=replace-with-saltHex:hashHex
WEB_ADMIN_NAME=Администратор

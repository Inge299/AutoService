# Never commit real values. Generate WEB_SESSION_SECRET with at least 32 random characters.
AUTOSERVICE_DEMO_MODE=false
AUTOSERVICE_API_URL=http://127.0.0.1:8080
# Required only by the non-production demo actor; real users always use bearer sessions.
# AUTOSERVICE_INTERNAL_API_KEY=replace-with-at-least-32-random-characters
WEB_SESSION_SECRET=replace-with-a-long-random-secret
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-a-stable-base64-encoded-32-byte-key

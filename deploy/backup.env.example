# Copy to /etc/autoservice/backup.env and replace every placeholder. Keep mode 600.
BACKUP_S3_ENDPOINT=https://backup-storage.example.com
BACKUP_S3_BUCKET=autoservice-backups
BACKUP_S3_ACCESS_KEY=replace-with-backup-only-access-key
BACKUP_S3_SECRET_KEY=replace-with-backup-only-secret
BACKUP_S3_PREFIX=production

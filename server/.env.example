NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
INTERNAL_API_KEY=replace-with-a-dedicated-32-character-service-key
ACCESS_TOKEN_SECRET=replace-with-a-different-32-character-signing-secret
OTP_HASH_SECRET=replace-with-a-third-32-character-otp-secret
SMS_PROVIDER=disabled
# SMS_RU_API_ID=replace-with-api-id
# SMS_RU_FROM=AutoService
# callcheck works without an alphanumeric Sender ID; set sms after sender approval.
SMS_RU_VERIFICATION_MODE=callcheck
# SMSC WaitCall for staff login. Configure the callback URL in the SMSC account:
# https://api.example.com/public/v1/auth/phone/smsc-wait-call?token=<SMSC_WAIT_CALL_CALLBACK_SECRET>
# SMS_PROVIDER=smsc
# SMSC_LOGIN=your-smsc-login
# SMSC_API_KEY=your-smsc-api-key
# SMSC_WAIT_CALL_CALLBACK_SECRET=replace-with-a-random-32-character-secret
DATABASE_URL=postgresql://autoservice:autoservice@localhost:5432/autoservice?schema=public
S3_ENDPOINT=http://localhost:9000
# In production this is the HTTPS address exposed to Android for presigned PUT/GET.
# S3_PUBLIC_ENDPOINT=https://storage.example.com
S3_REGION=ru-central1
S3_BUCKET=autoservice-media
S3_ACCESS_KEY_ID=autoservice
S3_SECRET_ACCESS_KEY=change-me
S3_FORCE_PATH_STYLE=true
WORKER_POLL_INTERVAL_MS=1000

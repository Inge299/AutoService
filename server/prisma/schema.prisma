generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  ADMIN
  EMPLOYEE
}

enum VisitStatus {
  DRAFT
  IN_REPAIR
  WAITING_APPROVAL
  COMPLETED
  CANCELLED
}

enum FindingPriority {
  CRITICAL
  IMPORTANT
  PLANNED
}

enum FindingStatus {
  DRAFT
  READY_FOR_APPROVAL
  SENT_TO_CUSTOMER
  APPROVED
  DECLINED
  CALL_REQUESTED
  DEFERRED
}

enum MediaKind {
  PHOTO
  VIDEO
  VOICE
}

enum MediaState {
  PENDING_UPLOAD
  UPLOADED
  VERIFYING
  VERIFIED
  PROCESSING
  READY
  RETRY
  BLOCKED
}

enum ApprovalDecisionValue {
  APPROVED
  DECLINED
  DEFERRED
  CALL_REQUESTED
}

enum JobState {
  PENDING
  RUNNING
  RETRY
  SUCCEEDED
  DEAD
}

enum ReportStatus {
  DRAFT
  PUBLISHED
}

enum ReminderState {
  PENDING
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

enum AuthScope {
  STAFF
  CUSTOMER
}

enum OtpPurpose {
  STAFF_LOGIN
  CUSTOMER_LOGIN
  CUSTOMER_REGISTRATION
}

enum VerificationMethod {
  SMS
  CALLCHECK
}

model Workshop {
  id            String            @id @db.Uuid
  name          String
  phone         String?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  memberships   Membership[]
  customers     Customer[]
  vehicles      Vehicle[]
  visits        Visit[]
  findings      Finding[]
  media         MediaAsset[]
  approvals     ApprovalVersion[]
  reports       Report[]
  reportVersions ReportVersion[]
  reminders     Reminder[]
  jobs          BackgroundJob[]
  auditEvents   AuditEvent[]
  authSessions  AuthSession[]
  otpChallenges OtpChallenge[]

  @@map("workshops")
}

model User {
  id               String         @id @db.Uuid
  login            String?        @unique
  phone            String?        @unique
  email            String?        @unique
  passwordHash     String?        @map("password_hash")
  isActive         Boolean        @default(true) @map("is_active")
  displayName      String         @map("display_name")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at")
  memberships      Membership[]
  customerProfiles Customer[]     @relation("CustomerAccount")
  devices          Device[]
  authSessions     AuthSession[]
  otpChallenges    OtpChallenge[]

  @@map("users")
}

model Membership {
  workshopId String         @map("workshop_id") @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  role       MembershipRole
  isActive   Boolean        @default(true) @map("is_active")
  createdAt  DateTime       @default(now()) @map("created_at")
  workshop   Workshop       @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workshopId, userId])
  @@map("memberships")
}

model Device {
  id             String   @id @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  installationId String   @unique @map("installation_id")
  lastSeenAt     DateTime @default(now()) @map("last_seen_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

model Customer {
  id            String         @id @db.Uuid
  workshopId    String         @map("workshop_id") @db.Uuid
  name          String
  phone         String
  email         String?
  accountUserId String?        @unique @map("account_user_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  workshop      Workshop       @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  accountUser   User?          @relation("CustomerAccount", fields: [accountUserId], references: [id], onDelete: SetNull)
  vehicles      Vehicle[]
  visits        Visit[]
  authSessions  AuthSession[]
  otpChallenges OtpChallenge[]

  @@unique([workshopId, phone])
  @@index([workshopId])
  @@map("customers")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  workshopId       String    @map("workshop_id") @db.Uuid
  customerId       String?   @map("customer_id") @db.Uuid
  scope            AuthScope
  refreshTokenHash String    @unique @map("refresh_token_hash")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workshop         Workshop  @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  customer         Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model OtpChallenge {
  id            String     @id @default(uuid()) @db.Uuid
  purpose       OtpPurpose
  phone         String
  codeHash      String     @map("code_hash")
  verificationMethod VerificationMethod @default(SMS) @map("verification_method")
  providerCheckId     String?            @map("provider_check_id")
  callVerifiedAt      DateTime?          @map("call_verified_at")
  requestIpHash String     @map("request_ip_hash")
  userId        String?    @map("user_id") @db.Uuid
  workshopId    String?    @map("workshop_id") @db.Uuid
  customerId    String?    @map("customer_id") @db.Uuid
  attempts      Int        @default(0)
  maxAttempts   Int        @default(5) @map("max_attempts")
  expiresAt     DateTime   @map("expires_at")
  resendAfter   DateTime   @map("resend_after")
  consumedAt    DateTime?  @map("consumed_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  user          User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workshop      Workshop?  @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  customer      Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([phone, purpose, createdAt])
  @@index([requestIpHash, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model Vehicle {
  id           String    @id @db.Uuid
  workshopId   String    @map("workshop_id") @db.Uuid
  customerId   String?   @map("customer_id") @db.Uuid
  label        String
  licensePlate String    @default("") @map("license_plate")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  workshop     Workshop  @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  visits       Visit[]

  @@index([workshopId, licensePlate])
  @@map("vehicles")
}

model Visit {
  id            String            @id @db.Uuid
  workshopId    String            @map("workshop_id") @db.Uuid
  customerId    String?           @map("customer_id") @db.Uuid
  vehicleId     String?           @map("vehicle_id") @db.Uuid
  customerName  String            @map("customer_name")
  customerPhone String            @map("customer_phone")
  vehicleLabel  String            @map("vehicle_label")
  licensePlate  String            @map("license_plate")
  mileageKm     Int?              @map("mileage_km")
  complaint     String
  status        VisitStatus       @default(DRAFT)
  serverVersion Int               @default(1) @map("server_version")
  createdAt     DateTime          @map("created_at")
  updatedAt     DateTime          @map("updated_at")
  workshop      Workshop          @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  customer      Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vehicle       Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  findings      Finding[]
  media         MediaAsset[]
  approvals     ApprovalVersion[]
  report        Report?
  reportVersions ReportVersion[]
  sourceReminders Reminder[] @relation("ReminderSourceVisit")
  returnedReminders Reminder[] @relation("ReminderReturnVisit")

  @@index([workshopId, status, updatedAt])
  @@map("visits")
}

model Finding {
  id            String            @id @db.Uuid
  workshopId    String            @map("workshop_id") @db.Uuid
  visitId       String            @map("visit_id") @db.Uuid
  title         String
  description   String
  priceRub      Int?              @map("price_rub")
  priority      FindingPriority
  status        FindingStatus     @default(DRAFT)
  serverVersion Int               @default(1) @map("server_version")
  createdAt     DateTime          @map("created_at")
  updatedAt     DateTime          @map("updated_at")
  workshop      Workshop          @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  visit         Visit             @relation(fields: [visitId], references: [id], onDelete: Cascade)
  media         MediaAsset[]
  approvals     ApprovalVersion[]

  @@index([workshopId, visitId])
  @@map("findings")
}

model MediaAsset {
  id          String     @id @db.Uuid
  operationId String     @unique @map("operation_id") @db.Uuid
  workshopId  String     @map("workshop_id") @db.Uuid
  visitId     String     @map("visit_id") @db.Uuid
  findingId   String?    @map("finding_id") @db.Uuid
  kind        MediaKind
  mimeType    String     @map("mime_type")
  byteCount   BigInt     @map("byte_count")
  sha256      String
  objectKey   String     @unique @map("object_key")
  state       MediaState @default(PENDING_UPLOAD)
  lastError   String?    @map("last_error")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  workshop    Workshop   @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  visit       Visit      @relation(fields: [visitId], references: [id], onDelete: Cascade)
  finding     Finding?   @relation(fields: [findingId], references: [id], onDelete: SetNull)

  @@index([workshopId, visitId])
  @@index([state])
  @@map("media_assets")
}

model ApprovalVersion {
  id          String            @id @default(uuid()) @db.Uuid
  operationId String            @unique @map("operation_id") @db.Uuid
  workshopId  String            @map("workshop_id") @db.Uuid
  visitId     String            @map("visit_id") @db.Uuid
  findingId   String            @map("finding_id") @db.Uuid
  version     Int
  title       String
  description String
  priceRub    Int               @map("price_rub")
  mediaIds    String[]          @map("media_ids") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at")
  workshop    Workshop          @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  visit       Visit             @relation(fields: [visitId], references: [id], onDelete: Cascade)
  finding     Finding           @relation(fields: [findingId], references: [id], onDelete: Restrict)
  link        ApprovalLink?
  decision    ApprovalDecision?

  @@unique([findingId, version])
  @@index([workshopId])
  @@map("approval_versions")
}

model ApprovalLink {
  id                String          @id @default(uuid()) @db.Uuid
  approvalVersionId String          @unique @map("approval_version_id") @db.Uuid
  tokenHash         String          @unique @map("token_hash")
  expiresAt         DateTime        @map("expires_at")
  revokedAt         DateTime?       @map("revoked_at")
  openedAt          DateTime?       @map("opened_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  approvalVersion   ApprovalVersion @relation(fields: [approvalVersionId], references: [id], onDelete: Cascade)

  @@map("approval_links")
}

model ApprovalDecision {
  id                String                @id @default(uuid()) @db.Uuid
  approvalVersionId String                @unique @map("approval_version_id") @db.Uuid
  value             ApprovalDecisionValue
  createdAt         DateTime              @default(now()) @map("created_at")
  approvalVersion   ApprovalVersion       @relation(fields: [approvalVersionId], references: [id], onDelete: Restrict)

  @@map("approval_decisions")
}

model Report {
  id              String       @id @default(uuid()) @db.Uuid
  workshopId      String       @map("workshop_id") @db.Uuid
  visitId         String       @unique @map("visit_id") @db.Uuid
  completedWork   String       @default("") @map("completed_work")
  recommendations String       @default("")
  nextVisitAt     DateTime?    @map("next_visit_at")
  status          ReportStatus @default(DRAFT)
  publishedAt     DateTime?    @map("published_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  workshop        Workshop     @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  visit           Visit        @relation(fields: [visitId], references: [id], onDelete: Cascade)
  versions        ReportVersion[]

  @@index([workshopId, status, updatedAt])
  @@map("reports")
}

model ReportVersion {
  id              String       @id @default(uuid()) @db.Uuid
  operationId     String       @unique @map("operation_id") @db.Uuid
  reportId        String       @map("report_id") @db.Uuid
  workshopId      String       @map("workshop_id") @db.Uuid
  visitId         String       @map("visit_id") @db.Uuid
  version         Int
  customerName    String       @map("customer_name")
  customerPhone   String       @map("customer_phone")
  vehicleLabel    String       @map("vehicle_label")
  licensePlate    String       @map("license_plate")
  mileageKm       Int?         @map("mileage_km")
  complaint       String
  completedWork   String       @map("completed_work")
  recommendations String
  nextVisitAt     DateTime?    @map("next_visit_at")
  findings        Json
  mediaIds        String[]     @map("media_ids") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at")
  report          Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  workshop        Workshop     @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  visit           Visit        @relation(fields: [visitId], references: [id], onDelete: Cascade)
  link            ReportLink?
  reminder        Reminder?

  @@unique([reportId, version])
  @@index([workshopId])
  @@map("report_versions")
}

model ReportLink {
  id              String        @id @default(uuid()) @db.Uuid
  reportVersionId String        @unique @map("report_version_id") @db.Uuid
  tokenHash       String        @unique @map("token_hash")
  expiresAt       DateTime      @map("expires_at")
  revokedAt       DateTime?     @map("revoked_at")
  openedAt        DateTime?     @map("opened_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  reportVersion   ReportVersion @relation(fields: [reportVersionId], references: [id], onDelete: Cascade)

  @@map("report_links")
}

model Reminder {
  id              String        @id @default(uuid()) @db.Uuid
  workshopId      String        @map("workshop_id") @db.Uuid
  reportVersionId String        @unique @map("report_version_id") @db.Uuid
  visitId         String        @map("visit_id") @db.Uuid
  returnVisitId   String?       @map("return_visit_id") @db.Uuid
  customerName    String        @map("customer_name")
  customerPhone   String        @map("customer_phone")
  vehicleLabel    String        @map("vehicle_label")
  reason          String
  dueAt           DateTime      @map("due_at")
  sendAt          DateTime      @map("send_at")
  state           ReminderState @default(PENDING)
  providerMessageId String?     @map("provider_message_id")
  sentAt          DateTime?     @map("sent_at")
  deliveredAt     DateTime?     @map("delivered_at")
  cancelledAt     DateTime?     @map("cancelled_at")
  attempts        Int           @default(0)
  lastError       String?       @map("last_error")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  workshop        Workshop      @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  reportVersion   ReportVersion @relation(fields: [reportVersionId], references: [id], onDelete: Cascade)
  visit           Visit         @relation("ReminderSourceVisit", fields: [visitId], references: [id], onDelete: Cascade)
  returnVisit     Visit?        @relation("ReminderReturnVisit", fields: [returnVisitId], references: [id], onDelete: SetNull)
  jobs            BackgroundJob[]

  @@index([workshopId, state, sendAt])
  @@index([workshopId, dueAt])
  @@map("reminders")
}

model BackgroundJob {
  id             String    @id @default(uuid()) @db.Uuid
  workshopId     String?   @map("workshop_id") @db.Uuid
  reminderId     String?   @map("reminder_id") @db.Uuid
  type           String
  payload        Json
  state          JobState  @default(PENDING)
  idempotencyKey String    @unique @map("idempotency_key")
  attempts       Int       @default(0)
  runAfter       DateTime  @default(now()) @map("run_after")
  lockedUntil    DateTime? @map("locked_until")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  workshop       Workshop? @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  reminder       Reminder? @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@index([state, runAfter])
  @@index([reminderId])
  @@map("background_jobs")
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  workshopId  String   @map("workshop_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  workshop    Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@index([workshopId, createdAt])
  @@map("audit_events")
}

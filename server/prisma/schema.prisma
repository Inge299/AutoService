generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  ADMIN
  EMPLOYEE
}

enum VisitStatus {
  DRAFT
  IN_REPAIR
  WAITING_APPROVAL
  COMPLETED
  CANCELLED
}

enum FindingPriority {
  CRITICAL
  IMPORTANT
  PLANNED
}

enum FindingStatus {
  DRAFT
  READY_FOR_APPROVAL
  SENT_TO_CUSTOMER
  APPROVED
  DECLINED
  CALL_REQUESTED
  DEFERRED
}

enum MediaKind {
  PHOTO
  VIDEO
  VOICE
}

enum MediaState {
  PENDING_UPLOAD
  UPLOADED
  VERIFYING
  VERIFIED
  PROCESSING
  READY
  RETRY
  BLOCKED
}

enum ApprovalDecisionValue {
  APPROVED
  DECLINED
  DEFERRED
  CALL_REQUESTED
}

enum JobState {
  PENDING
  RUNNING
  RETRY
  SUCCEEDED
  DEAD
}

model Workshop {
  id          String       @id @db.Uuid
  name        String
  phone       String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  memberships Membership[]
  customers   Customer[]
  vehicles    Vehicle[]
  visits      Visit[]
  findings    Finding[]
  media       MediaAsset[]
  approvals   ApprovalVersion[]
  jobs        BackgroundJob[]
  auditEvents AuditEvent[]

  @@map("workshops")
}

model User {
  id          String       @id @db.Uuid
  phone       String       @unique
  displayName String       @map("display_name")
  createdAt   DateTime     @default(now()) @map("created_at")
  memberships Membership[]
  devices     Device[]

  @@map("users")
}

model Membership {
  workshopId String         @map("workshop_id") @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  role       MembershipRole
  createdAt  DateTime       @default(now()) @map("created_at")
  workshop   Workshop       @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workshopId, userId])
  @@map("memberships")
}

model Device {
  id          String   @id @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  installationId String @unique @map("installation_id")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

model Customer {
  id          String    @id @db.Uuid
  workshopId  String    @map("workshop_id") @db.Uuid
  name        String
  phone       String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  workshop    Workshop  @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  vehicles    Vehicle[]
  visits      Visit[]

  @@unique([workshopId, phone])
  @@index([workshopId])
  @@map("customers")
}

model Vehicle {
  id           String    @id @db.Uuid
  workshopId   String    @map("workshop_id") @db.Uuid
  customerId   String?   @map("customer_id") @db.Uuid
  label        String
  licensePlate String    @default("") @map("license_plate")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  workshop     Workshop  @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  visits       Visit[]

  @@index([workshopId, licensePlate])
  @@map("vehicles")
}

model Visit {
  id             String      @id @db.Uuid
  workshopId     String      @map("workshop_id") @db.Uuid
  customerId     String?     @map("customer_id") @db.Uuid
  vehicleId      String?     @map("vehicle_id") @db.Uuid
  customerName   String      @map("customer_name")
  customerPhone  String      @map("customer_phone")
  vehicleLabel   String      @map("vehicle_label")
  licensePlate   String      @map("license_plate")
  mileageKm      Int?        @map("mileage_km")
  complaint      String
  status         VisitStatus @default(DRAFT)
  serverVersion  Int         @default(1) @map("server_version")
  createdAt      DateTime    @map("created_at")
  updatedAt      DateTime    @map("updated_at")
  workshop       Workshop    @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  customer       Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vehicle        Vehicle?    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  findings       Finding[]
  media          MediaAsset[]
  approvals      ApprovalVersion[]

  @@index([workshopId, status, updatedAt])
  @@map("visits")
}

model Finding {
  id            String          @id @db.Uuid
  workshopId    String          @map("workshop_id") @db.Uuid
  visitId       String          @map("visit_id") @db.Uuid
  title         String
  description   String
  priceRub      Int?            @map("price_rub")
  priority      FindingPriority
  status        FindingStatus   @default(DRAFT)
  serverVersion Int             @default(1) @map("server_version")
  createdAt     DateTime        @map("created_at")
  updatedAt     DateTime        @map("updated_at")
  workshop      Workshop        @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  visit         Visit           @relation(fields: [visitId], references: [id], onDelete: Cascade)
  media         MediaAsset[]
  approvals     ApprovalVersion[]

  @@index([workshopId, visitId])
  @@map("findings")
}

model MediaAsset {
  id            String      @id @db.Uuid
  operationId   String      @unique @map("operation_id") @db.Uuid
  workshopId    String      @map("workshop_id") @db.Uuid
  visitId       String      @map("visit_id") @db.Uuid
  findingId     String?     @map("finding_id") @db.Uuid
  kind          MediaKind
  mimeType      String      @map("mime_type")
  byteCount     BigInt      @map("byte_count")
  sha256        String
  objectKey     String      @unique @map("object_key")
  state         MediaState  @default(PENDING_UPLOAD)
  lastError     String?     @map("last_error")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  workshop      Workshop    @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  visit         Visit       @relation(fields: [visitId], references: [id], onDelete: Cascade)
  finding       Finding?    @relation(fields: [findingId], references: [id], onDelete: SetNull)

  @@index([workshopId, visitId])
  @@index([state])
  @@map("media_assets")
}

model ApprovalVersion {
  id            String         @id @default(uuid()) @db.Uuid
  workshopId    String         @map("workshop_id") @db.Uuid
  visitId       String         @map("visit_id") @db.Uuid
  findingId     String         @map("finding_id") @db.Uuid
  version       Int
  title         String
  description   String
  priceRub      Int            @map("price_rub")
  mediaIds      String[]       @map("media_ids") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at")
  workshop      Workshop       @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  visit         Visit          @relation(fields: [visitId], references: [id], onDelete: Cascade)
  finding       Finding        @relation(fields: [findingId], references: [id], onDelete: Restrict)
  link          ApprovalLink?
  decision      ApprovalDecision?

  @@unique([findingId, version])
  @@index([workshopId])
  @@map("approval_versions")
}

model ApprovalLink {
  id                String          @id @default(uuid()) @db.Uuid
  approvalVersionId String          @unique @map("approval_version_id") @db.Uuid
  tokenHash         String          @unique @map("token_hash")
  expiresAt         DateTime        @map("expires_at")
  revokedAt         DateTime?       @map("revoked_at")
  openedAt          DateTime?       @map("opened_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  approvalVersion   ApprovalVersion @relation(fields: [approvalVersionId], references: [id], onDelete: Cascade)

  @@map("approval_links")
}

model ApprovalDecision {
  id                String                @id @default(uuid()) @db.Uuid
  approvalVersionId String                @unique @map("approval_version_id") @db.Uuid
  value             ApprovalDecisionValue
  createdAt         DateTime              @default(now()) @map("created_at")
  approvalVersion   ApprovalVersion       @relation(fields: [approvalVersionId], references: [id], onDelete: Restrict)

  @@map("approval_decisions")
}

model BackgroundJob {
  id             String    @id @default(uuid()) @db.Uuid
  workshopId     String?   @map("workshop_id") @db.Uuid
  type           String
  payload        Json
  state          JobState  @default(PENDING)
  idempotencyKey String    @unique @map("idempotency_key")
  attempts       Int       @default(0)
  runAfter       DateTime  @default(now()) @map("run_after")
  lockedUntil    DateTime? @map("locked_until")
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  workshop       Workshop? @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@index([state, runAfter])
  @@map("background_jobs")
}

model AuditEvent {
  id          String    @id @default(uuid()) @db.Uuid
  workshopId  String    @map("workshop_id") @db.Uuid
  actorUserId String?   @map("actor_user_id") @db.Uuid
  action      String
  entityType  String    @map("entity_type")
  entityId    String    @map("entity_id")
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  workshop    Workshop  @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@index([workshopId, createdAt])
  @@map("audit_events")
}
